DISCORD_TOKEN=PASTE_YOUR_TOKEN_HERE
GUILD_ID=
DATABASE_PATH=./data/bot.db
ROBLOX_TIMEOUT=10s
REFRESH_INTERVAL=30m
LOG_LEVEL=info
# Web dashboard — cloudflared tunnel provides https
WEB_PORT=8080
WEB_URL=http://localhost:8080
# Admin-only dashboard login (hidden, no public button). Comma-separated Discord IDs allowed to access the dashboard.
ADMIN_DISCORD_IDS=
# Discord OAuth (only reached via the hidden /auth/discord/login used by the admin invite link — no public login button)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Roblox OAuth (for verification, create at https://create.roblox.com/dashboard/credentials)
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
