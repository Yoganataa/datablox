package pages

import "datablox/internal/web/templates/layouts"

templ Status(isBotStaff bool, discordName, discordAvatar string, botOnline bool, guildCount, expCount, voteCount int) {
	@layouts.Base("Datablox - Status", layouts.Nav{IsBotStaff: isBotStaff, DiscordName: discordName, DiscordAvatar: discordAvatar}) {
		<div class="max-w-4xl mx-auto">
			<div class="text-center mb-8">
				<h1 class="text-3xl font-extrabold tracking-tight">Status</h1>
				<p class="text-slate-500 mt-2 text-sm">All systems operational — live metrics from Datablox.</p>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
				<div class="rounded-2xl bg-white border border-slate-200 p-6 text-center">
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Bot</div>
					if botOnline {
						<div class="mt-2 inline-flex items-center gap-2 rounded-full bg-emerald-100 text-emerald-700 px-3 py-1 text-sm font-semibold">● Online</div>
					} else {
						<div class="mt-2 inline-flex items-center gap-2 rounded-full bg-red-100 text-red-700 px-3 py-1 text-sm font-semibold">● Offline</div>
					}
				</div>
				<div class="rounded-2xl bg-white border border-slate-200 p-6 text-center">
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Guilds</div>
					<div class="mt-2 text-2xl font-extrabold">{ guildCount }</div>
					<div class="text-xs text-slate-500">managed servers</div>
				</div>
				<div class="rounded-2xl bg-white border border-slate-200 p-6 text-center">
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Experiences</div>
					<div class="mt-2 text-2xl font-extrabold">{ expCount }</div>
					<div class="text-xs text-slate-500">catalogued</div>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div class="rounded-2xl bg-white border border-slate-200 p-6 text-center">
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Votes</div>
					<div class="mt-2 text-2xl font-extrabold">{ voteCount }</div>
				</div>
				<div class="rounded-2xl bg-white border border-slate-200 p-6">
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Uptime</div>
					<p class="text-sm text-slate-600">Web and bot share SQLite WAL, FTS5, and cron refresh. No external dependencies.</p>
					<p class="text-xs text-slate-400 mt-2">Checked just now • Auto-refresh every 30m</p>
				</div>
			</div>
			<div class="mt-6 rounded-2xl bg-slate-900 text-white p-6">
				<div class="text-sm font-semibold">Need help?</div>
				<p class="text-sm text-white/70 mt-1">See <a href="/guide" class="underline text-white">Guide</a> or email <a href="mailto:support@devest.live" class="underline text-white">support@devest.live</a>.</p>
			</div>
		</div>
	}
}
