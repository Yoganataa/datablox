package pages

import "datablox/internal/web/templates/layouts"

templ Privacy(isBotStaff bool, discordName, discordAvatar string) {
	@layouts.Base("Datablox - Privacy Policy", layouts.Nav{IsBotStaff: isBotStaff, DiscordName: discordName, DiscordAvatar: discordAvatar, Lang: "en"}) {
		<div class="max-w-4xl mx-auto">
			<div class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-[#0055ff] text-white p-8 sm:p-10 shadow-2xl shadow-slate-900/30 relative overflow-hidden">
				<div class="absolute -right-10 -top-10 w-44 h-44 rounded-full bg-[#00A2FF]/30 blur-3xl"></div>
				<div class="absolute -left-8 -bottom-14 w-40 h-40 rounded-full bg-[#5865F2]/30 blur-3xl"></div>
				<div class="relative">
					<div class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur px-3 py-1 text-xs font-semibold">Legal · Last updated: August 31, 2026</div>
					<h1 class="mt-4 text-2xl sm:text-3xl font-extrabold tracking-tight">Privacy Policy</h1>
					<p class="mt-2 text-white/70 text-sm">Datablox • https://datablox.devest.live • Scopes: <code class="bg-white/20 px-1.5 py-0.5 rounded text-xs">openid profile</code> · Category: Account Linking Tools</p>
				</div>
			</div>
			<div class="mt-6 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl p-6">
				<div class="flex items-start gap-3">
					<div class="w-8 h-8 rounded-full bg-blue-500 text-white grid place-items-center text-sm">ⓘ</div>
					<div>
						<div class="font-bold text-sm text-slate-900">In short</div>
						<ul class="mt-2 text-sm text-slate-700 list-disc pl-5 space-y-1">
							<li>We only get your Discord username + servers you share & Roblox ID/username via official Roblox login — never password.</li>
							<li>We save your votes, server settings, and role links, and delete when you unlink.</li>
							<li>Temporary secure cookies only to keep login safe (5 minutes to 7 days).</li>
						</ul>
					</div>
				</div>
			</div>
			<div class="mt-6 bg-white border border-slate-200/80 rounded-2xl shadow-sm">
				<div class="p-6 sm:p-8 text-sm leading-relaxed text-slate-700 space-y-7 [&_h2]:text-[15px] [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-slate-900 [&_h2]:mt-2 [&_a]:text-[#0055ff] [&_a]:underline-offset-4 hover:[&_a]:underline [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5 [&_code]:bg-slate-100 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-[13px]">
					<section>
						<h2>1. Overview</h2>
						<p class="mt-2">Datablox ("we", "us") is a Discord bot and web dashboard that catalogs Roblox experiences and provides secure Roblox verification (Discord ↔ Roblox account link) and a 1-channel server feed. This policy explains what data we collect when you use <code>https://datablox.devest.live</code> and our Discord bot, and via Roblox OAuth scopes <code>openid profile</code> (Account Linking Tools - <a href="https://en.help.roblox.com/hc/en-us/articles/37924211313044-Creator-Third-Party-App-Policy">Creator Third Party App Policy</a>). We only request the minimum scopes necessary.</p>
					</section>
					<section>
						<h2>2. Data We Collect</h2>
						<ul>
							<li><b>Discord:</b> When you log in with Discord, we only see your Discord username and which servers you share with Datablox. We store a secure login cookie.</li>
							<li><b>Roblox:</b> Clicking "Verify with Datablox" sends you to Roblox's official login. We only receive your Roblox ID and username — we never see your password.</li>
							<li><b>Roblox Public:</b> Games you add are public Roblox game info (name, description, players) — we save what you see.</li>
							<li><b>Votes & Configuration:</b> We save your votes, your server's channel settings, and which Discord roles match which Roblox ranks.</li>
							<li><b>Technical:</b> Standard web logs (IP) for abuse prevention. No advertising trackers.</li>
						</ul>
					</section>
					<section>
						<h2>3. How We Use Data</h2>
						<p class="mt-2">To (a) link your Discord and Roblox accounts, (b) sync roles/nicknames per guild bindings you configure, (c) display your catalog, votes, and 1-channel feed, and (d) provide the dashboard. We use data only as described in this policy and as permitted by the <a href="https://support-dev.discord.com/hc/en-us/articles/8562894815383-Discord-Developer-Terms-of-Service">Discord Developer Terms</a> and Roblox Third Party App Terms.</p>
						<p class="mt-2">We do <b>not</b>: track users across experiences or platforms, build behavioral profiles, share identifying information with third parties, sell data, use data for AI/LLM training, or use geolocation tracking.</p>
					</section>
					<section>
						<h2>4. Legal Basis, Sharing &amp; Applicable Laws</h2>
						<p class="mt-2">We process data based on your consent (OAuth authorization) and to provide the service. We comply with applicable privacy laws including GDPR, ePrivacy, UK GDPR, Brazil's LGPD, CCPA and CPRA. We share data only with Discord and Roblox APIs as necessary to fulfill verification and role sync. Data is not disclosed to data brokers, ad networks, or other monetization services. Cloudflare Tunnel encrypts traffic in transit.</p>
					</section>
					<section>
						<h2>5. Storage, Retention &amp; Deletion</h2>
						<p class="mt-2">Your data is stored securely on our server and deleted when you unlink or ask us to. Pending logins expire after 5 minutes. Poll votes are kept until the vote message is refreshed.</p>
						<p class="mt-1">How to request deletion or correction: email <a href="mailto:support@devest.live">support@devest.live</a>, use <a href="/verify">/verify</a> help, or revoke OAuth directly at <a href="https://www.roblox.com/my/account">Roblox Apps</a> and <a href="https://discord.com/developers/applications">Discord Apps</a>.</p>
					</section>
					<section>
						<h2>6. Cookies</h2>
						<p class="mt-2">We use temporary secure cookies only to keep your login safe. They expire after a few minutes to 7 days. No tracking cookies.</p>
					</section>
					<section>
						<h2>7. Children's Privacy</h2>
						<p class="mt-2">Roblox users under 13 require parental/verifiable consent for OAuth. We only request <code>openid profile</code> and do not knowingly collect data from children without consent. If you believe a child provided data without consent, contact us for deletion.</p>
					</section>
					<section>
						<h2>8. Your Rights (GDPR / CCPA / LGPD)</h2>
						<p class="mt-2">You have the right to access, correct, or delete your personal data, to object to processing, and to withdraw consent. To exercise these rights, email <a href="mailto:support@devest.live">support@devest.live</a> or use the self-service controls: revoke Roblox access at <a href="https://www.roblox.com/my/account">Roblox</a> → Apps, revoke Discord access at <a href="https://discord.com/developers/applications">Discord</a>, or re-verify/unlink from the Discord Verify button. We respond within 30 days.</p>
					</section>
					<section>
						<h2>9. Changes</h2>
						<p class="mt-2">We post updates here and bump the "Last updated" date. Continued use after changes means acceptance.</p>
					</section>
					<section>
						<h2>10. Contact</h2>
						<p class="mt-2">Datablox • <a href="https://datablox.devest.live">https://datablox.devest.live</a> • Email: <a href="mailto:support@devest.live">support@devest.live</a> • Discord App: Datablox • For OAuth review, this URL is the Privacy Policy URL in Discord Developer Portal and Roblox Creator Dashboard.</p>
					</section>
				</div>
			</div>
			<div class="mt-6 text-center text-sm"><a href="/terms" class="text-slate-500 hover:text-slate-900 underline-offset-4 hover:underline">Terms of Service →</a></div>
		</div>
	}
}
