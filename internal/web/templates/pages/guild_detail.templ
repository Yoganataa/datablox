package pages

import (
	"fmt"

	"datablox/components/badge"
	"datablox/components/card"
	"datablox/components/table"
	"datablox/internal/model"
	"datablox/internal/web/templates/layouts"
)

templ GuildDetail(guildID, guildName, guildIcon string, memberCount int, feedChannelName, verifyChannelName string, cfg model.GuildConfig, bindings []model.GuildBinding, reactionRoles []model.ReactionRole, isAdmin bool, discordName, discordAvatar string) {
	@layouts.Base(guildName+" - Datablox", layouts.Nav{IsAdmin: isAdmin, DiscordName: discordName, DiscordAvatar: discordAvatar}) {
		<div class="max-w-5xl mx-auto flex flex-col gap-6">
			<a href="/dashboard/guilds" class="text-sm font-medium text-slate-500 hover:text-slate-900 inline-flex items-center gap-1">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg> My Servers
			</a>
			<div class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-[#0055ff] text-white p-8 shadow-xl relative overflow-hidden">
				<div class="absolute -right-10 -top-10 w-44 h-44 rounded-full bg-[#00A2FF]/30 blur-3xl"></div>
				<div class="relative flex items-center gap-4">
					if guildIcon != "" {
						<img src={ "https://cdn.discordapp.com/icons/" + guildID + "/" + guildIcon + ".png?size=128" } alt={ guildName } class="w-16 h-16 rounded-2xl object-cover border-2 border-white/20 shadow-lg"/>
					} else {
						<div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur grid place-items-center text-xl font-bold">{ guildName[:1] }</div>
					}
					<div>
						<h1 class="text-2xl font-extrabold tracking-tight">{ guildName }</h1>
						<p class="text-white/70 text-sm">Server manager - feed, verification, and bindings</p>
						<p class="text-white/50 text-xs mt-1">
							if memberCount >= 0 {
								{ fmt.Sprintf("%d members", memberCount) } - 
							}
							Use <code class="bg-white/20 px-1.5 py-0.5 rounded text-xs">/config</code> in Discord to edit channels
						</p>
					</div>
				</div>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Channels 
						}
					}
					@card.Content() {
						<div class="space-y-3 text-sm">
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Feed Channel</span>
								if cfg.ChannelID != "" {
									<span class="font-medium">{ feedChannelName } <span class="text-slate-400 font-mono text-xs">#{ cfg.ChannelID }</span></span>
								} else {
									<span class="text-amber-600">Not set - run /config</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Verify Channel</span>
								if cfg.VerifyChannelID != "" {
									<span class="font-medium">{ verifyChannelName } <span class="text-slate-400 font-mono text-xs">#{ cfg.VerifyChannelID }</span></span>
								} else {
									<span class="text-amber-600">Not set - run /config</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Default Genre</span>
								if cfg.DefaultGenre != "" {
									@badge.Badge(badge.Props{Variant: "secondary"}) {
										{ cfg.DefaultGenre }
									}
								} else {
									<span class="text-slate-500">Not set</span>
								}
							</div>
						</div>
					}
				}
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Messages 
						}
					}
					@card.Content() {
						<div class="space-y-3 text-sm">
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Vote Message</span>
								if cfg.VoteMessageID != "" && cfg.ChannelID != "" {
									<a href={ templ.SafeURL("https://discord.com/channels/" + guildID + "/" + cfg.ChannelID + "/" + cfg.VoteMessageID) } target="_blank" class="text-blue-600 hover:text-blue-700 font-mono text-xs">View in Discord -></a>
								} else if cfg.VoteMessageID != "" {
									<span class="font-mono text-xs">Set</span>
								} else {
									<span class="text-slate-400">Not created</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Top Message</span>
								if cfg.TopMessageID != "" && cfg.ChannelID != "" {
									<a href={ templ.SafeURL("https://discord.com/channels/" + guildID + "/" + cfg.ChannelID + "/" + cfg.TopMessageID) } target="_blank" class="text-blue-600 hover:text-blue-700 font-mono text-xs">View -></a>
								} else if cfg.TopMessageID != "" {
									<span class="font-mono text-xs">Set</span>
								} else {
									<span class="text-slate-400">Not created</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Verify Message</span>
								if cfg.VerifyMessageID != "" && cfg.VerifyChannelID != "" {
									<a href={ templ.SafeURL("https://discord.com/channels/" + guildID + "/" + cfg.VerifyChannelID + "/" + cfg.VerifyMessageID) } target="_blank" class="text-blue-600 hover:text-blue-700 font-mono text-xs">View -></a>
								} else if cfg.VerifyMessageID != "" {
									<span class="font-mono text-xs">Set</span>
								} else {
									<span class="text-slate-400">Not created</span>
								}
							</div>
						</div>
					}
				}
			</div>
			@card.Card() {
				@card.Header() {
					<div class="flex items-center justify-between w-full">
						@card.Title() {
							Reaction Roles 
						}
						@badge.Badge(badge.Props{Variant: "secondary"}) {
							{ fmt.Sprintf("%d roles", len(reactionRoles)) }
						}
					</div>
				}
				@card.Content() {
					if len(reactionRoles) == 0 {
						<div class="p-6 text-center text-sm text-slate-500">
							No reaction roles yet.
							<br/>
							<span class="text-xs">Create via Discord: react to a message with emoji -> role (max 20 per message).</span>
						</div>
					} else {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Emoji 
									}
									@table.Head() {
										Role 
									}
									@table.Head() {
										Mode 
									}
								}
							}
							@table.Body() {
								for _, rr := range reactionRoles {
									@table.Row() {
										@table.Cell() {
											<span class="text-lg">{ rr.Emoji }</span>
										}
										@table.Cell() {
											<span class="font-mono text-xs">{ rr.RoleID }</span>
										}
										@table.Cell() {
											@badge.Badge(badge.Props{Variant: "outline"}) {
												{ rr.Mode }
											}
										}
									}
								}
							}
						}
					}
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Moderation 
					}
				}
				@card.Content() {
					<p class="text-sm text-slate-500">Moderate with <code>/warn</code> <code>/mute</code> <code>/ban</code> <code>/kick</code> <code>/purge</code> - only visible to admins.</p>
					<div class="mt-2 text-xs text-slate-400">Use in Discord.</div>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Leveling 
					}
				}
				@card.Content() {
					<p class="text-sm text-slate-500">Members gain XP (15-25 per message, 60s cooldown). Check level command for your rank and leaderboard for top 10.</p>
					<div class="mt-2 text-xs text-slate-400">Level up announced in chat.</div>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Welcome & AutoRole 
					}
				}
				@card.Content() {
					<p class="text-sm text-slate-500">Welcome new members with a banner and give an auto-role on join.</p>
					<div class="mt-2 text-xs text-slate-400">Automod blocks invites and mass mentions - configure via <code>/config</code>.</div>
				}
			}
			@card.Card() {
				@card.Header() {
					<div class="flex items-center justify-between w-full">
						@card.Title() {
							Group Bindings 
						}
						@badge.Badge(badge.Props{Variant: "secondary"}) {
							{ fmt.Sprintf("%d bindings", len(bindings)) }
						}
					</div>
				}
				@card.Content() {
					if len(bindings) == 0 {
						<div class="p-8 text-center text-sm text-slate-500">
							No group bindings yet. Link a Roblox group rank to a Discord role - use <code>/config</code> in Discord to add.
						</div>
					} else {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Group ID 
									}
									@table.Head() {
										Discord Role 
									}
									@table.Head() {
										Rank 
									}
									@table.Head() {
										Template 
									}
								}
							}
							@table.Body() {
								for _, b := range bindings {
									@table.Row() {
										@table.Cell() {
											<span class="font-mono text-xs">{ fmt.Sprintf("%d", b.GroupID) }</span>
										}
										@table.Cell() {
											<span class="font-mono text-xs">{ b.DiscordRoleID }</span>
										}
										@table.Cell() {
											if b.RankMin != nil && b.RankMax != nil {
												<span class="text-xs">{ fmt.Sprintf("%d-%d", *b.RankMin, *b.RankMax) }</span>
											} else if b.RobloxRoleID != nil {
												<span class="text-xs">Role { fmt.Sprintf("%d", *b.RobloxRoleID) }</span>
											} else {
												<span class="text-slate-400">-</span>
											}
										}
										@table.Cell() {
											<span class="text-xs">{ b.NicknameTemplate }</span>
										}
									}
								}
							}
						}
					}
				}
			}
		</div>
	}
}
