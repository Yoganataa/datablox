package pages

import (
	"fmt"

	"datablox/components/badge"
	"datablox/components/card"
	"datablox/components/table"
	"datablox/internal/model"
	"datablox/internal/web/templates/layouts"
)

templ GuildDetail(guildID, guildName string, cfg model.GuildConfig, bindings []model.GuildBinding, isAdmin bool, discordName string) {
	@layouts.Base(guildName+" — Datablox", layouts.Nav{IsAdmin: isAdmin, DiscordName: discordName}) {
		<div class="max-w-5xl mx-auto flex flex-col gap-6">
			<a href="/dashboard/guilds" class="text-sm font-medium text-slate-500 hover:text-slate-900 inline-flex items-center gap-1">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg> My Servers
			</a>
			<div class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-[#0055ff] text-white p-8 shadow-xl relative overflow-hidden">
				<div class="absolute -right-10 -top-10 w-44 h-44 rounded-full bg-[#00A2FF]/30 blur-3xl"></div>
				<div class="relative">
					<div class="text-xs font-semibold text-white/60 font-mono">{ guildID }</div>
					<h1 class="mt-1 text-2xl font-extrabold tracking-tight">{ guildName }</h1>
					<p class="mt-1 text-white/70 text-sm">Server manager — feed, verification, and bindings. Use <code class="bg-white/20 px-1.5 py-0.5 rounded text-xs">/config</code> in Discord to edit.</p>
				</div>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
				@card.Card() {
					@card.Header() {
						@card.Title() { Channels }
					}
					@card.Content() {
						<div class="space-y-3 text-sm">
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Feed Channel</span>
								if cfg.ChannelID != "" {
									@badge.Badge() { #{ cfg.ChannelID } }
								} else {
									<span class="text-amber-600">Not set</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Verify Channel</span>
								if cfg.VerifyChannelID != "" {
									@badge.Badge(badge.Props{Variant: "outline"}) { #{ cfg.VerifyChannelID } }
								} else {
									<span class="text-amber-600">Not set</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Default Genre</span>
								if cfg.DefaultGenre != "" {
									@badge.Badge(badge.Props{Variant: "secondary"}) { { cfg.DefaultGenre } }
								} else {
									<span class="text-slate-500">—</span>
								}
							</div>
						</div>
					}
				}
				@card.Card() {
					@card.Header() {
						@card.Title() { Messages }
					}
					@card.Content() {
						<div class="space-y-3 text-sm">
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Vote Message</span>
								if cfg.VoteMessageID != "" {
									<span class="font-mono text-xs">{ cfg.VoteMessageID }</span>
								} else {
									<span class="text-slate-400">—</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Top Message</span>
								if cfg.TopMessageID != "" {
									<span class="font-mono text-xs">{ cfg.TopMessageID }</span>
								} else {
									<span class="text-slate-400">—</span>
								}
							</div>
							<div class="flex items-center justify-between">
								<span class="text-slate-500">Verify Message</span>
								if cfg.VerifyMessageID != "" {
									<span class="font-mono text-xs">{ cfg.VerifyMessageID }</span>
								} else {
									<span class="text-slate-400">—</span>
								}
							</div>
						</div>
					}
				}
			</div>
			@card.Card() {
				@card.Header() {
					<div class="flex items-center justify-between w-full">
						@card.Title() { Reaction Roles }
						@badge.Badge(badge.Props{Variant: "outline"}) { Emoji → Role }
					</div>
				}
				@card.Content() {
					<p class="text-sm text-slate-500">Custom roles via emoji reactions — like Carl/MEE6. Modes: <code class="bg-slate-100 px-1 py-0.5 rounded text-xs">normal</code> (add/remove), <code class="bg-slate-100 px-1 py-0.5 rounded text-xs">verify</code> (add-only gate), <code class="bg-slate-100 px-1 py-0.5 rounded text-xs">unique</code> (1 role/message). Max 20 per message (Discord limit). Manage via <code class="bg-slate-100 px-1 py-0.5 rounded text-xs">POST /api/reaction-roles</code>.</p>
					<div class="mt-3 text-xs text-slate-400">Store: <code>reaction_roles(guild_id, message_id, emoji, role_id, mode)</code> — react to get role, unreact to remove (except verify).</div>
				}
			}
			@card.Card() {
				@card.Header() {
					<div class="flex items-center justify-between w-full">
						@card.Title() { Group Bindings }
						@badge.Badge(badge.Props{Variant: "secondary"}) { { fmt.Sprintf("%d bindings", len(bindings)) } }
					</div>
				}
				@card.Content() {
					if len(bindings) == 0 {
						<div class="p-8 text-center text-sm text-slate-500">
							No group bindings yet. Use <code class="bg-slate-100 px-1.5 py-0.5 rounded">/bind</code> or manage via API.
						</div>
					} else {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() { Group ID }
									@table.Head() { Discord Role }
									@table.Head() { Rank }
									@table.Head() { Template }
								}
							}
							@table.Body() {
								for _, b := range bindings {
									@table.Row() {
										@table.Cell() { <span class="font-mono text-xs">{ fmt.Sprintf("%d", b.GroupID) }</span> }
										@table.Cell() { <span class="font-mono text-xs">{ b.DiscordRoleID }</span> }
										@table.Cell() {
											if b.RankMin != nil && b.RankMax != nil {
												<span class="text-xs">{ fmt.Sprintf("%d–%d", *b.RankMin, *b.RankMax) }</span>
											} else if b.RobloxRoleID != nil {
												<span class="text-xs">Role { fmt.Sprintf("%d", *b.RobloxRoleID) }</span>
											} else {
												<span class="text-slate-400">—</span>
											}
										}
										@table.Cell() { <span class="text-xs">{ b.NicknameTemplate }</span> }
									}
								}
							}
						}
					}
				}
			}
		</div>
	}
}
