package pages

import (
	"datablox/internal/web/templates/layouts"
)

templ Landing(isAdmin bool, discordName, discordAvatar, clientID string, guildCount, expCount, voteCount int) {
	@layouts.Base("Datablox — Roblox Verification", layouts.Nav{IsAdmin: isAdmin, DiscordName: discordName, DiscordAvatar: discordAvatar}) {
		<div class="mx-auto max-w-4xl">
			<!-- Hero -->
			<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0055ff] via-[#0088ff] to-[#00d4ff] text-white shadow-2xl shadow-blue-500/30">
				<div class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-white/15 blur-2xl"></div>
				<div class="absolute -left-10 -bottom-20 w-56 h-56 rounded-full bg-[#00ffd5]/20 blur-2xl"></div>
				<div class="relative px-8 sm:px-12 py-14 sm:py-16">
					<div class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-3 py-1 text-xs font-semibold">
						<span class="w-2 h-2 rounded-full bg-[#00ffd5] animate-pulse"></span> 8 modules — enable what you need
					</div>
					<h1 class="mt-5 text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1]">
						Manage your<br/>Discord, your way
					</h1>
					<p class="mt-4 text-blue-50/90 text-base sm:text-lg max-w-xl">
						One platform for moderation, automation, leveling, welcome, reaction roles, role bindings, verification and feeds — enable only what you need.
					</p>
					<div class="mt-8 flex flex-col sm:flex-row gap-3">
						if clientID != "" {
							<a href={ templ.SafeURL("https://discord.com/oauth2/authorize?client_id=" + clientID + "&permissions=268435456&scope=bot%20applications.commands") } target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white text-blue-700 px-6 py-3.5 text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
								Invite Datablox
								<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
							</a>
						} else {
							<a href="/dashboard" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white text-blue-700 px-6 py-3.5 text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
								Invite Datablox
								<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
							</a>
						}
						<a href="/dashboard" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/40 bg-white/10 backdrop-blur px-6 py-3.5 text-sm font-bold text-white hover:bg-white/20 transition-colors">
							View Dashboard
						</a>
					</div>
				</div>
			</div>
			<div class="mt-8 grid grid-cols-3 gap-4 text-center">
				<div class="rounded-2xl bg-white/80 backdrop-blur border border-slate-200/60 p-4">
					<div class="text-2xl font-extrabold">{ guildCount }</div>
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Servers</div>
				</div>
				<div class="rounded-2xl bg-white/80 backdrop-blur border border-slate-200/60 p-4">
					<div class="text-2xl font-extrabold">{ expCount }</div>
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Experiences</div>
				</div>
				<div class="rounded-2xl bg-white/80 backdrop-blur border border-slate-200/60 p-4">
					<div class="text-2xl font-extrabold">{ voteCount }</div>
					<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Votes</div>
				</div>
			</div>
			<p class="text-center text-xs text-slate-400 mt-3">Trusted by communities of all sizes</p>

			<!-- How it works -->
			<div class="mt-14">
				<div class="text-center">
					<h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">How it works</h2>
					<p class="text-slate-500 mt-2 text-sm sm:text-base">Three steps — enable only the modules you need.</p>
				</div>
				<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-5">
					@stepCard("1", "bg-[#5865F2]", "Invite Bot", "Add Datablox to your server and authorize permissions.")
					@stepCard("2", "bg-[#00A2FF]", "Enable modules", "Open dashboard or run /config — toggle moderation, leveling, welcome, reaction roles, bindings, verification and feeds.")
					@stepCard("3", "bg-[#00c97a]", "Members use features", "Members verify, react, level up and get roles automatically.")
				</div>
			</div>

			<!-- Modules — equal grid -->
			<div class="mt-14">
				<div class="text-center">
					<h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Everything you need</h2>
					<p class="text-slate-500 mt-2 text-sm sm:text-base">Eight modules, same design — enable what you need, disable the rest.</p>
				</div>
				<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
					@moduleCard("AutoMod", "Spam, invite and mention filters with exemptions.", "shield-alert")
					@moduleCard("Bindings", "Roblox group ranks to Discord roles and nicknames.", "link")
					@moduleCard("Feed", "Roblox catalog browsing, voting and top lists.", "rss")
					@moduleCard("Leveling", "XP, levels and leaderboards from chat activity.", "trophy")
					@moduleCard("Moderation", "Warn, mute, ban, kick and purge with history.", "gavel")
					@moduleCard("Reaction Roles", "Emoji role assignment — normal, unique, verify and reverse.", "smile-plus")
					@moduleCard("Verify", "Secure Roblox OAuth linking — one Discord to one Roblox.", "badge-check")
					@moduleCard("Welcome", "Greeting messages and auto-role with banner image.", "hand")
				</div>
			</div>

			<!-- Final CTA -->
			<div class="mt-14 rounded-3xl border border-slate-200/80 bg-white/70 backdrop-blur p-8 sm:p-10 text-center shadow-sm">
				<h3 class="text-xl sm:text-2xl font-extrabold tracking-tight">Ready to manage your server?</h3>
				<p class="text-slate-500 mt-2 text-sm sm:text-base max-w-md mx-auto">
					Invite Datablox, configure channels with /config, and let members verify via /verify in Discord.
				</p>
				<div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
					if clientID != "" {
						<a href={ templ.SafeURL("https://discord.com/oauth2/authorize?client_id=" + clientID + "&permissions=268435456&scope=bot%20applications.commands") } target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-[#5865F2] to-[#7c4dff] text-white px-7 py-3.5 text-sm font-bold shadow-lg shadow-purple-500/30 hover:shadow-xl hover:-translate-y-0.5 transition-all">
							Invite Bot
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
						</a>
					}
					<a href="/dashboard" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-7 py-3.5 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors">
						View Dashboard
					</a>
				</div>
				<p class="mt-4 text-xs text-slate-400">Members verify via <code class="bg-slate-100 px-1 py-0.5 rounded">/verify</code> inside Discord — not from this page.</p>
			</div>
		</div>
	}
}

templ stepCard(num string, accentBg string, title string, desc string) {
	<div class="rounded-2xl bg-white border border-slate-200/80 shadow-sm p-6 hover:shadow-lg hover:-translate-y-1 transition-all">
		<div class="flex items-center gap-3">
			<div class={ "w-9 h-9 rounded-xl text-white grid place-items-center text-sm font-bold shadow-md", accentBg }>{ num }</div>
			<div class="font-bold text-[15px]">{ title }</div>
		</div>
		<p class="text-sm text-slate-500 mt-3">{ desc }</p>
	</div>
}

templ moduleCard(title string, desc string, icon string) {
	<div class="module-card rounded-2xl bg-white border border-slate-200/80 shadow-sm p-5 hover:shadow-md hover:border-slate-300 transition-all">
		<div class="w-9 h-9 rounded-lg bg-slate-900 text-white grid place-items-center text-xs font-bold">{ icon[:1] }</div>
		<div class="font-bold text-[14px] mt-3">{ title }</div>
		<p class="text-xs text-slate-500 mt-1.5 leading-relaxed">{ desc }</p>
	</div>
}
