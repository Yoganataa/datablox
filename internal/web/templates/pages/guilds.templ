package pages

import (
	"datablox/components/badge"
	"datablox/components/card"
	"datablox/internal/model"
	"datablox/internal/web/templates/layouts"
)

templ Guilds(userGuilds []model.DiscordGuild, cfgMap map[string]model.GuildConfig, isAdmin bool, discordName, discordAvatar string) {
	@layouts.Base("Datablox - My Servers", layouts.Nav{IsAdmin: isAdmin, DiscordName: discordName, DiscordAvatar: discordAvatar}) {
		<div class="max-w-5xl mx-auto flex flex-col gap-6">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-extrabold tracking-tight">My Servers</h1>
					<p class="text-sm text-slate-500 mt-1">Servers where you have Manage Server permission and Datablox is installed.</p>
				</div>
				<a href="/dashboard" class="text-sm font-medium text-slate-600 hover:text-slate-900">Back to dashboard</a>
			</div>
			if len(userGuilds) == 0 {
				@card.Card() {
					@card.Content() {
						<div class="p-10 text-center">
							<div class="text-sm font-semibold">No servers found</div>
							<p class="text-sm text-slate-500 mt-1">Make sure you are logged into the correct Discord account and have Manage Server permission.</p>
							<a href="/auth/discord/login" class="mt-4 inline-flex text-sm font-medium text-blue-600 hover:text-blue-700">Re-authorize →</a>
						</div>
					}
				}
			} else {
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
					for _, g := range userGuilds {
						@guildCard(g, cfgMap[g.ID])
					}
				</div>
			}
		</div>
	}
}

templ guildCard(g model.DiscordGuild, cfg model.GuildConfig) {
	<a href={ templ.SafeURL("/guild/" + g.ID) } class="group rounded-2xl bg-white border border-slate-200/80 shadow-sm p-5 hover:shadow-lg hover:-translate-y-0.5 transition-all flex flex-col gap-3">
		<div class="flex items-center gap-3">
			if g.Icon != "" {
				<img src={ "https://cdn.discordapp.com/icons/" + g.ID + "/" + g.Icon + ".png?size=64" } alt={ g.Name } class="w-10 h-10 rounded-xl object-cover"/>
			} else {
				<div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#5865F2] to-[#7c4dff] text-white grid place-items-center font-bold">{ g.Name[:1] }</div>
			}
			<div class="min-w-0">
				<div class="font-semibold text-sm truncate">{ g.Name }</div>
				<div class="text-xs text-slate-500 font-mono truncate">{ g.ID }</div>
			</div>
		</div>
		<div class="flex flex-wrap gap-1.5">
			if cfg.ChannelID != "" {
				@badge.Badge(badge.Props{Variant: "secondary"}) { Feed }
			} else {
				@badge.Badge(badge.Props{Variant: "outline"}) { No feed }
			}
			if cfg.VerifyChannelID != "" {
				@badge.Badge(badge.Props{Variant: "secondary"}) { Verify }
			} else {
				@badge.Badge(badge.Props{Variant: "outline"}) { No verify }
			}
			if g.Owner {
				@badge.Badge() { Owner }
			}
		</div>
		<div class="text-xs text-slate-500 mt-1">
			if cfg.ChannelID != "" || cfg.VerifyChannelID != "" {
				Configured
			} else {
				Not configured — run /config in Discord
			}
		</div>
	</a>
}
