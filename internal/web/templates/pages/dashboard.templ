package pages

import (
	"datablox/components/badge"
	"datablox/components/card"
	"datablox/internal/web/templates/layouts"
)

templ Dashboard(guildCount, expCount, voteCount, verifiedCount int, isBotStaff bool, discordName, discordAvatar, clientID string) {
	@layouts.Base("Datablox - Dashboard", layouts.Nav{IsBotStaff: isBotStaff, DiscordName: discordName, DiscordAvatar: discordAvatar}) {
		<div class="flex flex-col gap-8">
			<div class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-[#0055ff] text-white p-8 sm:p-10 shadow-2xl shadow-slate-900/30 relative overflow-hidden">
				<div class="absolute -right-10 -top-10 w-44 h-44 rounded-full bg-[#00A2FF]/30 blur-3xl"></div>
				<div class="absolute -left-8 -bottom-14 w-40 h-40 rounded-full bg-[#5865F2]/30 blur-3xl"></div>
				<div class="relative">
					<div class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur px-3 py-1 text-xs font-semibold">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Bot is online
					</div>
					<h1 class="mt-4 text-2xl sm:text-3xl font-extrabold tracking-tight">Datablox</h1>
					<p class="mt-2 text-white/70 text-sm sm:text-base">All-in-one server manager for Roblox communities. Manage everything directly from Discord.</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a href={ templ.SafeURL("https://discord.com/oauth2/authorize?client_id=" + clientID + "&permissions=268435456&scope=bot%20applications.commands") } target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-white text-slate-900 px-5 py-2.5 text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
							Invite Bot
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
						</a>
						<a href="/verify" class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur border border-white/20 text-white px-5 py-2.5 text-sm font-semibold hover:bg-white/20 transition-colors">
							How to verify
						</a>
						if discordName != "" {
							<a href="/guilds" class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur border border-white/20 text-white px-5 py-2.5 text-sm font-semibold hover:bg-white/20 transition-colors">
								My Servers
							</a>
						} else {
							<a href="/auth/discord/login" hx-boost="false" class="inline-flex items-center gap-2 rounded-xl bg-white text-blue-700 px-5 py-2.5 text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
								<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
								Login with Discord
							</a>
						}
					</div>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
				@statCard("Managed Servers", guildCount, "from-[#5865F2] to-[#7c4dff]")
				@statCard("Experiences", expCount, "from-[#00A2FF] to-[#0055ff]")
				@statCard("Total Votes", voteCount, "from-emerald-500 to-teal-500")
				@statCard("Verified Users", verifiedCount, "from-amber-500 to-orange-500")
			</div>
			@card.Card() {
				@card.Header() {
					@card.Title() { Modules — enable only what you need }
					@badge.Badge(badge.Props{Variant: "secondary"}) {
						8 modules
					}
				}
				@card.Content() {
					<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">AutoMod</div><div class="text-slate-500 text-xs mt-1">Spam &amp; invite filters</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">Bindings</div><div class="text-slate-500 text-xs mt-1">Group ranks → roles</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">Feed</div><div class="text-slate-500 text-xs mt-1">Catalog, voting &amp; top</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">Leveling</div><div class="text-slate-500 text-xs mt-1">XP, levels, leaderboard</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">Moderation</div><div class="text-slate-500 text-xs mt-1">Warn, mute, ban, kick, purge</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">Reaction Roles</div><div class="text-slate-500 text-xs mt-1">Emoji → role (4 modes)</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">Verify</div><div class="text-slate-500 text-xs mt-1">Roblox OAuth linking</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-3">
							<div class="font-bold text-slate-900 text-xs">Welcome</div><div class="text-slate-500 text-xs mt-1">Greeting &amp; auto-role</div>
						</div>
					</div>
					<p class="text-xs text-slate-400 mt-3">All modules equal — toggle via dashboard (soon) or <code class="bg-slate-100 px-1 py-0.5 rounded">/config</code> in Discord. Enabled first (A-Z), disabled after (A-Z).</p>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() { Server Management }
				}
				@card.Content() {
					<p class="text-sm text-slate-600 leading-relaxed">
						Each server enables only the modules it needs — moderation, automod, leveling, welcome, reaction roles, bindings, verification and feeds. Configure with <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs">/config</code> in Discord.
						Server data stays private. Only admins with Manage Server can configure their community.
					</p>
					if isBotStaff {
						<div class="mt-4 rounded-xl bg-blue-50 border border-blue-200 p-4 text-sm text-blue-900">
							Signed in as <b>{ discordName }</b> — you have super-admin access. Use Discord <code class="bg-white px-1 py-0.5 rounded">/config</code> in each server to manage.
						</div>
					} else {
						<div class="mt-4 text-sm text-slate-500">
							Tip: invite the bot, then run <code class="bg-slate-100 px-1.5 py-0.5 rounded">/config</code> in your server's admin channel.
						</div>
					}
				}
			}
		</div>
	}
}

templ statCard(label string, value int, gradient string) {
	<div class="relative overflow-hidden rounded-2xl bg-white border border-slate-200/80 shadow-sm p-6 hover:shadow-lg hover:-translate-y-1 transition-all">
		<div class={ "absolute inset-x-0 top-0 h-1 bg-gradient-to-r", gradient }></div>
		<div class="text-sm font-medium text-slate-500">{ label }</div>
		<div class="mt-3 text-4xl font-extrabold tracking-tight">{ value }</div>
	</div>
}
