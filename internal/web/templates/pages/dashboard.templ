package pages

import (
	"datablox/components/badge"
	"datablox/components/card"
	"datablox/internal/web/templates/layouts"
)

templ Dashboard(guildCount, expCount, voteCount, verifiedCount int, isAdmin bool, discordName, clientID string) {
	@layouts.Base("Datablox - Dashboard", layouts.Nav{IsAdmin: isAdmin, DiscordName: discordName}) {
		<div class="flex flex-col gap-8">
			<div class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-[#0055ff] text-white p-8 sm:p-10 shadow-2xl shadow-slate-900/30 relative overflow-hidden">
				<div class="absolute -right-10 -top-10 w-44 h-44 rounded-full bg-[#00A2FF]/30 blur-3xl"></div>
				<div class="absolute -left-8 -bottom-14 w-40 h-40 rounded-full bg-[#5865F2]/30 blur-3xl"></div>
				<div class="relative">
					<div class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur px-3 py-1 text-xs font-semibold">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Bot is online
					</div>
					<h1 class="mt-4 text-2xl sm:text-3xl font-extrabold tracking-tight">Datablox</h1>
					<p class="mt-2 text-white/70 text-sm sm:text-base">Server manager bot — Roblox catalog, voting, and Bloxlink-like verification. Manage your servers via Discord.</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a href={ templ.SafeURL("https://discord.com/oauth2/authorize?client_id=" + clientID + "&permissions=8&scope=bot%20applications.commands") } target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-white text-slate-900 px-5 py-2.5 text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
							Invite Bot
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
						</a>
						<a href="/verify" class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur border border-white/20 text-white px-5 py-2.5 text-sm font-semibold hover:bg-white/20 transition-colors">
							How to verify
						</a>
						if discordName != "" {
							<a href="/dashboard/guilds" class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur border border-white/20 text-white px-5 py-2.5 text-sm font-semibold hover:bg-white/20 transition-colors">
								My Servers
							</a>
						}
					</div>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
				@statCard("Managed Servers", guildCount, "from-[#5865F2] to-[#7c4dff]")
				@statCard("Experiences", expCount, "from-[#00A2FF] to-[#0055ff]")
				@statCard("Total Votes", voteCount, "from-emerald-500 to-teal-500")
				@statCard("Verified Users", verifiedCount, "from-amber-500 to-orange-500")
			</div>
			@card.Card() {
				@card.Header() {
					@card.Title() { Commands }
					@badge.Badge(badge.Props{Variant: "secondary"}) {
						4 commands
					}
				}
				@card.Content() {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-4">
							<div class="font-mono font-bold text-slate-900">/datablox</div>
							<div class="text-slate-500 mt-1">Browse experiences — panel with filters and pagination.</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-4">
							<div class="font-mono font-bold text-slate-900">/add &lt;url&gt;</div>
							<div class="text-slate-500 mt-1">Add a Roblox experience to the catalog.</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-4">
							<div class="font-mono font-bold text-slate-900">/search &lt;query&gt;</div>
							<div class="text-slate-500 mt-1">Search the catalog with FTS.</div>
						</div>
						<div class="rounded-xl bg-slate-50 border border-slate-200/60 p-4">
							<div class="font-mono font-bold text-slate-900">/config</div>
							<div class="text-slate-500 mt-1">Configure feed and verify channels (per server).</div>
						</div>
					</div>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() { Server Management }
				}
				@card.Content() {
					<p class="text-sm text-slate-600 leading-relaxed">
						Each Discord server configures its own <b>feed channel</b> (vote + top10 + announcements) and <b>verify channel</b> (welcome + Verify button) via <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs">/config</code> in Discord.
						No server list is shown here to protect privacy. Server admins manage their guild via Discord permissions.
					</p>
					if isAdmin {
						<div class="mt-4 rounded-xl bg-blue-50 border border-blue-200 p-4 text-sm text-blue-900">
							Signed in as <b>{ discordName }</b> — you have super-admin access. Use Discord <code class="bg-white px-1 py-0.5 rounded">/config</code> in each server to manage.
						</div>
					} else {
						<div class="mt-4 text-sm text-slate-500">
							Tip: invite the bot, then run <code class="bg-slate-100 px-1.5 py-0.5 rounded">/config</code> in your server's admin channel.
						</div>
					}
				}
			}
		</div>
	}
}

templ statCard(label string, value int, gradient string) {
	<div class="relative overflow-hidden rounded-2xl bg-white border border-slate-200/80 shadow-sm p-6 hover:shadow-lg hover:-translate-y-1 transition-all">
		<div class={ "absolute inset-x-0 top-0 h-1 bg-gradient-to-r", gradient }></div>
		<div class="text-sm font-medium text-slate-500">{ label }</div>
		<div class="mt-3 text-4xl font-extrabold tracking-tight">{ value }</div>
	</div>
}
