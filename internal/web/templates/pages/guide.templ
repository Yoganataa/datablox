package pages

import "datablox/internal/web/templates/layouts"

templ Guide(isAdmin bool, discordName, discordAvatar string) {
	@layouts.Base("Datablox - Guide", layouts.Nav{IsAdmin: isAdmin, DiscordName: discordName, DiscordAvatar: discordAvatar}) {
		<div class="max-w-4xl mx-auto">
			<div class="text-center mb-10">
				<h1 class="text-3xl font-extrabold tracking-tight">Guide</h1>
				<p class="text-slate-500 mt-2 text-sm">Everything you need to set up Datablox for your server.</p>
			</div>
			<div class="space-y-6">
				<div class="bg-white border border-slate-200/80 rounded-2xl p-6">
					<div class="flex items-center gap-3 mb-3">
						<div class="w-8 h-8 rounded-lg bg-[#5865F2] text-white grid place-items-center font-bold text-sm">1</div>
						<h2 class="font-bold">Invite the Bot</h2>
					</div>
					<p class="text-sm text-slate-600">Click <b>Invite Datablox</b> on the homepage and select your server. Authorize with <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs">bot + applications.commands</code> and ensure the bot role is above the roles it will manage.</p>
				</div>
				<div class="bg-white border border-slate-200/80 rounded-2xl p-6">
					<div class="flex items-center gap-3 mb-3">
						<div class="w-8 h-8 rounded-lg bg-[#00A2FF] text-white grid place-items-center font-bold text-sm">2</div>
						<h2 class="font-bold">Configure Channels</h2>
					</div>
					<p class="text-sm text-slate-600">In Discord, run <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs">/config</code> and choose your <b>Feed Channel</b> (vote + top 10 + announcements) and <b>Verify Channel</b> (welcome + Verify button). Set a default genre if you like.</p>
					<p class="text-xs text-slate-400 mt-2">Or manage via <a href="/dashboard/guilds" class="text-blue-600 hover:underline">My Servers → Guild Detail</a>.</p>
				</div>
				<div class="bg-white border border-slate-200/80 rounded-2xl p-6">
					<div class="flex items-center gap-3 mb-3">
						<div class="w-8 h-8 rounded-lg bg-[#00c97a] text-white grid place-items-center font-bold text-sm">3</div>
						<h2 class="font-bold">Verification</h2>
					</div>
					<p class="text-sm text-slate-600">Members click <b>Verify with Datablox</b> in the verify channel → authorize Roblox <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs">openid profile</code> → roles and nickname sync automatically. Already verified in another server? Clicking again gives <code class="bg-green-100 text-green-800 px-1.5 py-0.5 rounded text-xs">Already Verified</code> and grants roles in the new server.</p>
				</div>
				<div class="bg-white border border-slate-200/80 rounded-2xl p-6">
					<div class="flex items-center gap-3 mb-3">
						<div class="w-8 h-8 rounded-lg bg-amber-500 text-white grid place-items-center font-bold text-sm">4</div>
						<h2 class="font-bold">Group Bindings & Reaction Roles</h2>
					</div>
					<p class="text-sm text-slate-600">Link Roblox group ranks to Discord roles (bind) and create reaction roles (emoji → role, modes: normal/verify/unique, max 20 per message). Manage in <a href="/dashboard/guilds" class="text-blue-600 hover:underline">Guild Detail</a> or via <code class="bg-slate-100 px-1.5 py-0.5 rounded text-xs">/bind</code>.</p>
				</div>
				<div class="bg-white border border-slate-200/80 rounded-2xl p-6">
					<div class="flex items-center gap-3 mb-3">
						<div class="w-8 h-8 rounded-lg bg-slate-800 text-white grid place-items-center font-bold text-sm">5</div>
						<h2 class="font-bold">Moderation, Leveling & Welcome</h2>
					</div>
					<p class="text-sm text-slate-600"><b>Moderation:</b> <code>/warn /mute /ban /kick /purge</code> (hidden from members). <b>Leveling:</b> 15-25 XP per message, 60s cooldown, <code>/level</code> & <code>/leaderboard</code>. <b>Welcome:</b> banner + auto-role on join. <b>Automod:</b> blocks invites & mass mentions.</p>
				</div>
				<div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 text-center">
					<p class="text-sm text-blue-900">Need help? Contact <a href="mailto:support@devest.live" class="underline">support@devest.live</a> or check <a href="/status" class="underline">Status</a>.</p>
				</div>
			</div>
		</div>
	}
}
